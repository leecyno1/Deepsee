# Production-lite configuration for Deepsee single-server installs.
# Copy to .env, then fill secrets and local/cloud paths.
APP_ENV=production
HOST=127.0.0.1
PORT=8001
DATABASE_URL=sqlite:///./data/app.db

# Keep low-spec 2G/2-core machines responsive by default.
SYNC_INTERVAL_SECONDS=0
EMAIL_SYNC_INTERVAL_SECONDS=0
NEWSNOW_REFRESH_INTERVAL_SECONDS=0
NEWS_SNAPSHOT_INTERVAL_SECONDS=0
AGGREGATION_RETENTION_DAYS=90
AGGREGATION_RETENTION_INTERVAL_SECONDS=86400
AI_MAX_PARALLEL=2

# Local integrations. Leave empty if not installed on this machine.
CHATLOG_HTTP_BASE=http://127.0.0.1:5031
CHATLOG_DIR=
MEDIA_SERVER_BASE=
MEDIA_COLLECTOR_DAILY_ENABLED=false
MEDIA_COLLECTOR_DAILY_HOUR=5
MEDIA_COLLECTOR_DAILY_MINUTE=0
MEDIA_COLLECTOR_TIMEOUT_SECONDS=240
MEDIA_COLLECTOR_AUTO_BOOTSTRAP=true
MEDIA_COLLECTOR_BOOTSTRAP_TIMEOUT_SECONDS=60
MEDIA_CACHE_CLEANUP_ENABLED=true
MEDIA_CACHE_TTL_HOURS=720
MEDIA_CACHE_MAX_MB=256
MEDIA_CACHE_CLEANUP_INTERVAL_SECONDS=86400
NEWS_DATASET_DIR=./data/datasets
NEWS_REMOTE_ENABLED=0
NEWS_ONLINE_TRANSLATION_ENABLED=0
COLLECTOR_DATA_DIR=./data
WE_MP_RSS_DB=
WE_MP_RSS_DIR=
MP_REMOTE_ENABLED=0
LANGBOT_ADAPTER_LOG_DIR=

# Optional API auth. Set API_TOKEN before exposing beyond localhost.
API_TOKEN=
API_AUTH_REQUIRED=true

# Agent bridge for Hermes / 龙虾(OpenClaw). Set token and optional allow/block lists.
AGENT_API_TOKEN=
AGENT_API_TOKENS=
AGENT_API_ALLOWLIST=/api/health,/api/ready,/api/messages,/api/email,/api/newsfeed,/api/ai,/api/send,/api/wechat-gateway,/api/config
AGENT_API_BLOCKLIST=/api/admin/cleanup,/api/admin/aggregation-retention/prune
HERMES_HOME=
OPENCLAW_HOME=

# External LLM API. Models are configured in the UI after first launch.
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://app.watertimber.us/v1
SILICONFLOW_MODEL=gpt-5.5
SILICONFLOW_TOOL_MODEL=MiniMax-M3
AI_MAX_PARALLEL=32
ONEPAGE_IMAGE_MODE=auto
ONEPAGE_IMAGE_API_URL=
ONEPAGE_IMAGE_API_KEY=
ONEPAGE_IMAGE_MODEL=MiniMax-M3
ONEPAGE_IMAGE_SIZE=1024x1536
ONEPAGE_IMAGE_QUALITY=medium

# Optional Microsoft OAuth.
MS_CLIENT_ID=
MS_TENANT=consumers
