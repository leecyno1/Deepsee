# Deepsee — Environment Template
# Copy to .env and fill in your credentials.

# === Chatlog ===
CHATLOG_HTTP_BASE=http://127.0.0.1:5030
CHATLOG_DIR=/path/to/chatlog/your_wxid

# === n8n Webhooks (optional) ===
N8N_REPLY_WEBHOOK=
N8N_SUMMARY_WEBHOOK=
N8N_CONTACT_WEBHOOK=
N8N_SEND_WEBHOOK=
N8N_AUTH_TOKEN=

# === API Auth ===
API_TOKEN=your-api-token-here
AGENT_API_TOKEN=your-agent-api-token-here

# === Database ===
DATABASE_URL=sqlite:///./data/app.db

# === Media Server ===
MEDIA_SERVER_BASE=http://127.0.0.1:8001

# === Server ===
HOST=127.0.0.1
PORT=8001

# === Sync (seconds; 0 = manual trigger only) ===
SYNC_INTERVAL_SECONDS=0
SUMMARY_OVERLAY_INTERVAL_SECONDS=3600
NEWSNOW_REFRESH_INTERVAL_SECONDS=3600

# === AI ===
AI_MAX_PARALLEL=12
# LLM API key for SiliconFlow (primary fallback)
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
# MiniMax API key for WeChat auto-reply route
MINIMAX_API_KEY=your-minimax-api-key
