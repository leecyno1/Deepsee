# Deepsee — Environment Template
# Copy to .env and fill in your credentials.

# === Chatlog ===
CHATLOG_HTTP_BASE=http://127.0.0.1:5030
# WeChat raw data directory, e.g. .../Documents/xwechat_files/<wxid>
CHATLOG_DATA_DIR=/path/to/xwechat_files/your_wxid
# Chatlog decrypted work directory, e.g. ~/Documents/chatlog/<wxid>
CHATLOG_DIR=/path/to/chatlog/your_wxid
CHATLOG_WORK_DIR=/path/to/chatlog/your_wxid
CHATLOG_HTTP_SESSION_TIMEOUT_SECONDS=5
CHATLOG_HTTP_TIMEOUT_SECONDS=10
# Optional sidecar controls for scripts/chatlog_sidecar.sh
CHATLOG_BIN=/path/to/chatlog
CHATLOG_GRAY_PORT=5031
CHATLOG_STARTUP_TIMEOUT_SECONDS=45
CHATLOG_AUTO_DECRYPT=0
CHATLOG_PLATFORM=darwin
CHATLOG_VERSION=4

# === n8n Webhooks (optional) ===
N8N_REPLY_WEBHOOK=
N8N_SUMMARY_WEBHOOK=
N8N_CONTACT_WEBHOOK=
N8N_SEND_WEBHOOK=
N8N_AUTH_TOKEN=

# === API Auth ===
API_TOKEN=your-api-token-here
AGENT_API_TOKEN=your-agent-api-token-here

# === Database ===
DATABASE_URL=sqlite:///./data/app.db

# === Media Server ===
MEDIA_SERVER_BASE=http://127.0.0.1:8001
MEDIA_COLLECTOR_DAILY_ENABLED=true
MEDIA_COLLECTOR_DAILY_HOUR=5
MEDIA_COLLECTOR_DAILY_MINUTE=0
MEDIA_COLLECTOR_TIMEOUT_SECONDS=240

# === Server ===
HOST=127.0.0.1
PORT=8001

# === Sync (seconds; 0 = manual trigger only) ===
SYNC_INTERVAL_SECONDS=0
SUMMARY_OVERLAY_INTERVAL_SECONDS=3600
NEWSNOW_REFRESH_INTERVAL_SECONDS=3600

# === AI ===
AI_MAX_PARALLEL=12
# LLM API key for SiliconFlow (primary fallback)
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
# MiniMax API key for WeChat auto-reply route
MINIMAX_API_KEY=your-minimax-api-key
WECHAT_FALLBACK_API_KEY=
WECHAT_FALLBACK_API_BASE=https://api.minimaxi.com/v1
WECHAT_FALLBACK_MODEL=MiniMax-M3
